# Keep content-addressed catalogs, graphs and BUILD inventories byte-stable.
* text=auto eol=lf
*.json text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.png -text
*.jpg -text
*.jpeg -text
*.pdf -text
*.zip -text
*.tgz -text

{
  "name": "metis-academic-preset",
  "version": "1.7.0",
  "private": false,
  "description": "METIS：与 AI 共建研究流程，可视化跟踪执行，逐步调用科研技能，在同一工作台审阅和修改成果。",
  "license": "Apache-2.0",
  "icon": "./assets/icon.png",
  "exports": {
    ".": "./dsh-plugin/metis-unified/index.mjs",
    "./runtime": "./dsh-plugin/metis-unified/runtime.mjs",
    "./workbench": "./dsh-plugin/metis-unified/workbench.mjs",
    "./step-skills": "./dsh-plugin/metis-unified/host/steps-37853cc2228d2c0f9c53bce8a88808424d1b34132eabb0da0f6b1524c1a68dae.mjs",
    "./client": "./dsh-plugin/metis-unified/client.js",
    "./locale/*.json": "./dsh-plugin/metis-unified/locale/*.json",
    "./icon": "./dsh-plugin/metis-mode/icon.svg",
    "./cordis.patch.yml": "./dsh-plugin/metis-unified/cordis.patch.yml",
    "./package.json": "./package.json",
    "./composer-agent": "./dsh-plugin/metis-unified/host/composerAgent-9af3b457aed9c9923670433c30172af550296ef7d75675f0b0dd92f10702c523.mjs"
  },
  "files": [
    "dsh-plugin/metis-unified/",
    "dsh-plugin/metis-academic/",
    "dsh-plugin/metis-mode/",
    "dsh-plugin/metis-preset/",
    "src/metis_academic/",
    "pyproject.toml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "assets/",
    "NOTICE",
    "LICENSE_HISTORY.md",
    "licenses/"
  ],
  "scripts": {
    "build": "python dsh-plugin/metis-unified/prepare-ui.py && node dsh-plugin/metis-unified/prepare-ion.mjs && node dsh-plugin/metis-unified/prepare-host.mjs && python dsh-plugin/metis-unified/prepare-client.py",
    "test": "node --test dsh-plugin/metis-mode/tests/research-network.test.mjs dsh-plugin/metis-mode/tests/circuit-model.test.mjs dsh-plugin/metis-mode/tests/project-scene.test.mjs dsh-plugin/metis-preset/tests/step-activity.test.mjs dsh-plugin/metis-mode/client/tests/research-hierarchy.test.mjs dsh-plugin/metis-mode/client/tests/research-space.test.mjs",
    "build:hosts": "node tools/build-host-plugin.mjs",
    "test:hosts": "node --test portable/tests/core.test.mjs portable/tests/protocol.test.mjs",
    "prepack": "python dsh-plugin/metis-unified/prepare-ui.py && node dsh-plugin/metis-unified/prepare-ion.mjs && node dsh-plugin/metis-unified/prepare-host.mjs && python dsh-plugin/metis-unified/prepare-client.py"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh-plugin/metis-unified/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "three": "0.187.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "undici": "8.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "author": "TZUKWAN",
  "homepage": "https://github.com/TZUKWAN/METIS_ACADEMIC#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TZUKWAN/METIS_ACADEMIC.git"
  },
  "bugs": {
    "url": "https://github.com/TZUKWAN/METIS_ACADEMIC/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "metis",
    "research",
    "academic",
    "workflow",
    "skills",
    "research-assistant",
    "codex",
    "zcode",
    "mcp-apps"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.2.3-0 || >=0.2.2 <0.3.0-0",
    "node": ">=24"
  }
}
